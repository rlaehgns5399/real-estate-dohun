# 국토교통부 실거래가 API (data.go.kr)
MOLIT_API_KEY=your_data_go_kr_api_key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# 수집기는 서버에서만 돌므로 secret key(구 service_role)를 쓴다. RLS를 우회한다.
# Dashboard > Settings > API Keys 에서 발급 (sb_secret_... 형식)
SUPABASE_SECRET_KEY=sb_secret_xxx
# 레거시 폴백. secret key가 있으면 쓰이지 않으며, RLS를 켜면 동작하지 않는다.
SUPABASE_ANON_KEY=your_supabase_anon_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# 법정동 코드 (5자리) — 국토교통부 실거래가 조회용
TARGET_REGION_CODE=11680

# 관심 아파트는 Supabase apartments 테이블에 직접 등록
# 각 아파트별로 아래 정보가 필요합니다:
#   name             = 국토교통부 API에 나오는 아파트명 (정확히 일치해야 함)
#   naver_complex_id = 네이버 부동산 URL의 complexNo
#   kb_complex_id    = KB부동산 단지코드 (선택, 없으면 KB 시세 조회 안함)
#   region_code      = 법정동코드 5자리
